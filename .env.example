# Servidor
PORT=3001
NODE_ENV=development
# Origens do frontend liberadas no CORS (separe por vírgula)
FRONTEND_URL=http://localhost:5173
# URL pública da API (usada nos links de imagens enviadas)
PUBLIC_API_URL=http://localhost:3001/api

# Banco PostgreSQL — use DATABASE_URL em produção (Render/Neon/Supabase)
# DATABASE_URL=postgres://usuario:senha@host:5432/girakids_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=girakids_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# Administrador criado automaticamente na primeira inicialização
ADMIN_NOME=Mateus
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Numeração dos pedidos (continua a sequência da loja antiga)
PEDIDO_NUMERO_INICIAL=63100

# Cloudinary — imagens enviadas pelo site (produtos, expedição). Painel do
# Cloudinary → Dashboard → "API environment variable".
CLOUDINARY_URL=
# Pasta base no Cloudinary (opcional)
CLOUDINARY_PASTA=girakids

# Pagamentos online — banco/gateway de sua escolha (ver src/services/pagamentos)
# PAGAMENTO_PROVEDOR=modelo
# PAGAMENTO_API_URL=
# PAGAMENTO_API_KEY=
# PAGAMENTO_WEBHOOK_SECRET=

# Importação da loja antiga: senha inicial dos usuários importados (opcional)
# LEGADO_SENHA_PADRAO=

# ---- Comercial (herdado do AgarraMais) ----
# OpenAI: busca de transportadoras e análise de caixas
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_TRANSPORTADORAS=
OPENAI_MODEL_CALCULADORA=

# NFeMail (Pedidos e Notas Fiscais) — https://dev.nfemail.com.br
NFEMAIL_API_BASE_URL=
NFEMAIL_CNPJ=
NFEMAIL_API_KEY=

# VIPP / Correios (postagens e cotação de PAC/SEDEX no checkout)
VIPP_BASE_URL=https://vipp-novo.visualset.com.br/vipp
VIPP_USUARIO=
VIPP_SENHA=
